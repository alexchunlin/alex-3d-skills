#!/bin/sh
# cad: thin wrapper around headless Blender for the print-cad-blender skill.
#   cad build  build_assembly.py [-- script args]     run a cadlib build script
#   cad check  model.blend [checks.json] [out.json] [--only a,b] [--quick] [--no-diff]  run cadcheck (short summary,
#                                                    writes JSON; --only/--quick with no OUT write cadcheck.partial.json;
#                                                    prints the delta against the report it overwrote)
#   cad diff   [OLD.json] NEW.json [--manifest OLD NEW]   new / fixed / worse / better findings, requirements, manifest
#   cad q      model.blend <cadq command ...>        one-shot measurement (`cad q` alone lists the commands)
#   cad py     -c "import params as P; print(P.X)" | script.py [args]   Python with bpy + cadlib + ./ and ./parts on the path
#   cad rows   [cadcheck.json|manifest.json|checks.json] [REGEX] [--check a,b] [--findings]   one line per row; grep, don't json.load
#   cad bom    BOM_AND_ASSEMBLY.md manifest.json      BOM fastener table vs the model: size, length, head, count, stock
#   cad sheet  stl_dir out.png                       STL contact sheet in print orientation
#   cad printcheck stl_dir|part.stl [--manifest m.json] [--out j] [--render DIR] [--where] [--section Z,..|auto]
#                                                    support check on the exported STLs (layers, sloped faces); --where lists regions
#   cad slice  stl_dir|part.stl | --detect           real slicer, sandboxed and crash-guarded: support needed, time, filament
#   cad view   model.blend [cadcheck.json] -o out.html [--pose PIV_x=..]   one offline HTML page to spin, pose and take apart
# BLENDER overrides the Blender binary. Runs at nice 10 so a parallel CAD loop keeps its CPU.
set -e
HERE="$(cd "$(dirname "$0")" && pwd)"
# build scripts find cadlib through CAD_SKILL; default to the checkout this wrapper lives in, so a pinned copy
# never silently imports another checkout's cadlib (v2 A1 progress.md "Tool issues")
export CAD_SKILL="${CAD_SKILL:-$(dirname "$HERE")}"
BL="${BLENDER:-/Applications/Blender.app/Contents/MacOS/Blender}"
# Blender exits 0 when a --python script raises, and the filter pipe hid any status anyway, so a failed build looked
# like a good one and the next check read the old blend (v2 A4 launcher builder, FINDINGS V2A4-T1). Keep Blender's status.
run() {
  st="${TMPDIR:-/tmp}/cad.$$.status"
  { nice -n 10 "$BL" -b --factory-startup --python-exit-code 1 "$@" 2>&1; echo $? > "$st"; } |
    grep -v -E '^(Blender quit|Blender [0-9]|Fra:|Read blend|$)| blend +\|' || true
  rc=$(cat "$st" 2>/dev/null || echo 1); rm -f "$st"; return "$rc"
}
cmd="$1"; shift || true
case "$cmd" in
  build) s="$1"; shift; [ "${1:-}" = "--" ] && shift   # `cad build x.py -- --render` (v2 A1: Blender tried to open "--")
         run --python "$s" -- "$@" || { rc=$?; echo "cad: BUILD FAILED (exit $rc) in $s: model.blend, manifest and STLs on disk are from the last good build" >&2; exit "$rc"; } ;;
  check) b="$1"; shift
         # CONFIG and OUT are optional positionals; a flag in their place is not swallowed as a file name
         # (v2 A1: `cad check m.blend c.json --only ...` wrote a file called --only, FINDINGS V2A1-T4)
         # an empty string in the CONFIG or OUT slot means "none" and is consumed, so `cad check m.blend "" out.json --only x`
         # still writes out.json (daily 2026-11-03: read_stl and sweep_guard pass "" and lost their OUT to the partial default)
         c=""; case "${1:-}" in "") [ $# -gt 0 ] && shift ;; --*) ;; *) c="$1"; shift ;; esac
         # a partial run (--only/--quick) with no OUT goes to cadcheck.partial.json, never over the full report (issue #28)
         o="$(dirname "$b")/cadcheck.json"; pv=""; for a in "$@"; do { [ "$a" = --quick ] || { [ "$pv" = --only ] && [ -n "$a" ]; }; } && o="$(dirname "$b")/cadcheck.partial.json"; pv="$a"; done   # an empty --only is a full run, as in cadcheck.py
         case "${1:-}" in "") [ $# -gt 0 ] && shift ;; --*) ;; *) o="$1"; shift ;; esac
         # an explicit `--out X` among the flags wins over the default (v2 A5 precheck overwrote cadcheck.json, V2A5-T1)
         for a in "$@"; do [ "$a" = "--out" ] && o=""; done
         [ -n "$o" ] && set -- --out "$o" "$@"
         # anything after OUT passes through, e.g. --only fasteners,service --quick
         if [ -n "$c" ]; then run "$b" --python "$HERE/cadcheck.py" -- --config "$c" "$@"; else run "$b" --python "$HERE/cadcheck.py" -- "$@"; fi ;;
  q) case "${1:-}" in ""|-h|--help|help) sed -n '/^"""/,/^"""/p' "$HERE/cadq.py" | sed '1s/^"""//;$d'; exit 0 ;; esac
     # keep cadq's exit status through the filter: `cad q m.blend route ...` exits 1 on a clearance violation
     b="$1"; shift; qs="${TMPDIR:-/tmp}/cadq.$$.status"
     { run "$b" --python "$HERE/cadq.py" -- "$@" && echo 0 > "$qs" || echo $? > "$qs"; } | grep -E '^CADQ|Error|cadq:' || true
     rc=$(cat "$qs" 2>/dev/null || echo 1); rm -f "$qs"; exit "$rc" ;;
  py) # Python with bpy, cadlib and the project on sys.path: evaluate params or pure-geometry helpers without a build
      # (v2 A2: the launcher and feeder builders hand-stubbed bpy/cadlib to import params.py from plain python3)
      run --python-expr "import sys, os, runpy; sys.path[:0] = [os.getcwd(), os.path.join(os.getcwd(), 'parts'), '$HERE']; a = sys.argv[sys.argv.index('--') + 1:]; sys.argv = a; exec(a[1]) if a[0] == '-c' else runpy.run_path(a[0], run_name='__main__')" -- "$@" ;;
  diff) exec python3 -I "$HERE/caddiff.py" "$@" ;;  # plain python3: two reports of one design (issue #30, V2A5-T2)
  rows) exec python3 "$HERE/cadrows.py" "$@" ;;   # plain python3, no Blender (v2 A3: 67 hand dump scripts, V2A3-T1)
  bom) exec python3 -I "$HERE/cadbom.py" "$@" ;;       # plain python3 (v2 A3: stud M3 x 20 in the BOM, x 16 in the model, V2A3-F6)
  sheet) run --python-expr "import sys; sys.path.insert(0, '$HERE'); from cadlib import render; render.contact_sheet('$1', '$2')" ;;
  printcheck) # layer-by-layer support analysis on the exported STLs; exit 1 on a fail (FINDINGS "v2 post-freeze")
      run --python "$HERE/printcheck.py" -- "$@" ;;
  slice) exec python3 "$HERE/cadslice.py" "$@" ;;   # the only way a slicer may run (HARVEST_BRIEF "Printer safety, revised")
  view) # one offline HTML page: spin, pose, explode, click cadcheck's findings (cadview.py; exit 2 on a mismatched report)
      b="$1"; shift; run "$b" --python "$HERE/cadview.py" -- "$@" ;;
  *) sed -n '2,16p' "$0"; exit 2 ;;
esac
