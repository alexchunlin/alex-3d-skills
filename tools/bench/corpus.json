         "runs": [
          {"id": "designer", "kind": "designer", "type": "check", "config": "checks.json", "env": {"CAD_LAYER_CHECK": "0"}, "verify_out": "a1/cadcheck.json"},
          {"id": "layer", "kind": "designer", "type": "check", "config": "checks.json", "args": ["--only", "parts"], "env": {"CAD_LAYER_CHECK": "1"}, "verify_out": "a1/layer.json"}]},
